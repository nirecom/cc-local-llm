# Copy to .env (gitignored) and fill in your values. The client launchers
# (scripts/code-ccgw.ps1 on Windows, scripts/code-ccgw.sh on macOS/Linux) and the Mac
# services started by scripts/serverctl.sh all load this file at startup.

# --- ccgw client (all platforms) ---

# The LiteLLM gateway the Claude Code launcher sends every request to. Required:
# with it unset the launcher refuses to start rather than picking an endpoint.
# Does not change the model or the credential.
# Format: https://<host>:<port> — e.g. LITELLM_ANTHROPIC_BASE_URL=https://<mac-lan-ip>:8445
LITELLM_ANTHROPIC_BASE_URL=

# Credential the launcher presents to the gateway. Same value as
# LITELLM_MASTER_KEY. Required: no fallback token exists.
# Format: any non-empty string — e.g. LITELLM_CLIENT_KEY=sk-<generated>
LITELLM_CLIENT_KEY=

# Deprecated spelling of LITELLM_CLIENT_KEY, accepted for one release with a
# warning. Ignored when LITELLM_CLIENT_KEY is set.
# Format: any non-empty string — e.g. LITELLM_VIRTUAL_KEY=sk-<generated>
LITELLM_VIRTUAL_KEY=

#@if windows
# Points Node at your local mkcert root CA so it trusts the gateway certificate.
# Use the same root CA that signed the gateway cert; get its path from mkcert -CAROOT.
# May be left empty on the Mac itself, where the issuing CA is already local.
# Format: absolute path — e.g. CCGW_CA_CERT=C:\Users\<you>\AppData\Local\mkcert\rootCA.pem
CCGW_CA_CERT=
#@endif
#@if posix
CCGW_CA_CERT=
#@endif

# Confines every subagent to one route instead of the model its definition asks
# for. Leave empty to let each agent's own frontmatter decide.
# Format: a LiteLLM routing key, i.e. one of the LITELLM_*_MODEL values —
# e.g. CCGW_SUBAGENT_MODEL=devstral-small-2-24b
CCGW_SUBAGENT_MODEL=

# Model routing keys sent by Claude Code as model names in its requests, and
# shown as the active model in Claude Code's own UI. Changing this alone does
# not change which backend actually answers a tier -- both must be updated
# together for the two to agree.
# Format: string — e.g. LITELLM_HAIKU_MODEL=devstral-small-2-24b
# Haiku shares the sonnet key on purpose: the Windows llama-swap heavy group is
# exclusive, so two different models there would evict each other turn by turn.
LITELLM_HAIKU_MODEL=qwen3-coder-30b-a3b
LITELLM_SONNET_MODEL=qwen3-coder-30b-a3b
LITELLM_FABLE_MODEL=deepseek-v4-flash
LITELLM_OPUS_MODEL=qwen3-next-80b-a3b-thinking

# --- ds4 server (Mac backend) ---

# Bind address for ds4-server. Default 127.0.0.1 (loopback only, safe).
# Set to 0.0.0.0 for temporary LAN exposure to A/B test raw-server vs proxy.
# Revert to 127.0.0.1 after testing — raw ds4-server has no auth layer.
# Format: IP address — e.g. DS4_SERVER_HOST=0.0.0.0
DS4_SERVER_HOST=127.0.0.1

# --- ccgw proxy (Mac server side) ---

# Port the proxy listens on. Must match the port in LITELLM_CCGW_PROXY_URL.
# Format: integer — e.g. CCGW_PROXY_PORT=8443
CCGW_PROXY_PORT=8443

# Whether the proxy terminates TLS. off makes it serve plain HTTP, which is only
# safe together with a loopback CCGW_PROXY_HOST. Must be switched at the same time
# as CCGW_PROXY_HOST, LITELLM_CCGW_PROXY_URL and SSL_CERT_FILE — changing only some
# of the four leaves the gateway unable to connect.
# Format: on or off — e.g. CCGW_PROXY_TLS=off
CCGW_PROXY_TLS=on

# Bind address for the proxy. 0.0.0.0 accepts LAN clients; 127.0.0.1 restricts it
# to gateways running on this Mac. Does not change authentication, which is always
# required.
# Format: IP address — e.g. CCGW_PROXY_HOST=127.0.0.1
CCGW_PROXY_HOST=0.0.0.0

# Backend the proxy forwards authenticated, normalized requests to. Points at Mac
# llama-swap, which routes by model name to ds4-server or Laguna. Must be an origin
# with no path: the incoming path is appended to it verbatim.
# Format: http://host:port — e.g. CCGW_PROXY_UPSTREAM=http://127.0.0.1:18080
CCGW_PROXY_UPSTREAM=http://127.0.0.1:18080

# Token the proxy requires from every request reaching it. Must match the
# LITELLM_CCGW_PROXY_API_KEY value the gateway sends.
# Format: any non-empty string — e.g. CCGW_PROXY_AUTH_TOKEN=<generated-secret>
CCGW_PROXY_AUTH_TOKEN=

# Where the proxy reads its TLS leaf certificate/key from. Does not generate or
# validate the files — they must already exist at this path (mkcert-issued).
# Unused while CCGW_PROXY_TLS is off.
# Format: absolute path — e.g. CCGW_PROXY_CERT=~/.config/ccgw-proxy/cert.pem
CCGW_PROXY_CERT=~/.config/ccgw-proxy/cert.pem
CCGW_PROXY_KEY=~/.config/ccgw-proxy/key.pem

# Logs pre- and post-normalization request bodies for debugging. Purely
# diagnostic — does not change how the proxy handles requests.
# Format: on or off — e.g. CCGW_PROXY_TEE=on
CCGW_PROXY_TEE=off

CCGW_PROXY_LOG_DIR=~/Library/Caches/ccgw-proxy/log

# --- ccgw ops (lifecycle / logging) ---

# Write ccgw service stdout/stderr to log files (proxy.log / kvcache.log).
# off stops disk writes (does not affect CCGW_PROXY_TEE body-dump logs).
# Console output and CCGW_PROXY_TEE logging are unaffected.
# Format: on or off — e.g. CCGW_LOG=off
CCGW_LOG=on

# Apply ANSI color to ds4-server output in the terminal (not in log files).
# Has no effect on non-TTY output (launchd, nohup, pipes).
# Format: on or off — e.g. DS4_SERVER_COLOR_LOG=off
DS4_SERVER_COLOR_LOG=on

# Tag each line of `serverctl logs all` with a colored "[service]" prefix so
# lines stay attributable to their source even when one service logs far more
# than the others. Has no effect on non-TTY output (pipes/redirects always get
# a plain, uncolored prefix); does not affect log files.
# Format: on or off — e.g. CCGW_LOG_COLOR=off
CCGW_LOG_COLOR=on

# Number of backlog lines shown per service when `serverctl logs all` starts,
# before it switches to following new lines only. Does not limit ongoing
# output once following starts, and does not affect log files.
# Format: a positive integer — e.g. CCGW_LOG_TAIL_LINES=5
CCGW_LOG_TAIL_LINES=6

# --- llama-swap (Mac model process manager) ---

# Bind address for llama-swap. Default 127.0.0.1 (loopback only, reached
# solely by ccgw-proxy on the same machine).
# Format: IP address — e.g. LLAMA_SWAP_HOST=127.0.0.1
LLAMA_SWAP_HOST=127.0.0.1

# Port llama-swap listens on. Must match CCGW_PROXY_UPSTREAM.
# Format: integer — e.g. LLAMA_SWAP_PORT=18080
LLAMA_SWAP_PORT=18080

# --- litellm gateway (Mac server side, native process) ---

# Admin credential for the gateway, and the value clients present as
# LITELLM_CLIENT_KEY. Required: the gateway refuses to start without it.
# Format: any non-empty string — e.g. LITELLM_MASTER_KEY=sk-<generated>
LITELLM_MASTER_KEY=

# Bind address for the gateway. 0.0.0.0 accepts LAN clients; 127.0.0.1 restricts
# it to this Mac.
# Format: IP address — e.g. LITELLM_HOST=127.0.0.1
LITELLM_HOST=0.0.0.0

# Port the gateway listens on. Must match the port in LITELLM_ANTHROPIC_BASE_URL.
# Format: integer — e.g. LITELLM_PORT=8445
LITELLM_PORT=8445

# Whether the gateway terminates TLS. Clients verify the certificate against
# CCGW_CA_CERT, so off is only usable from this Mac itself.
# Format: on or off — e.g. LITELLM_TLS=off
LITELLM_TLS=on

# TLS leaf certificate and private key the gateway serves (mkcert-issued). Both
# are required while LITELLM_TLS is on, and unused while it is off. The files must
# already exist — nothing here generates them.
# Format: absolute path — e.g. LITELLM_TLS_CERT=/Users/<you>/.config/litellm/cert.pem
LITELLM_TLS_CERT=
LITELLM_TLS_KEY=

# Root CA the gateway trusts when it connects over HTTPS to the CCGW Proxy and to
# the Windows PC's TLS front. Leave empty only once both of those hops are plain
# HTTP. Tilde is not expanded.
# Format: absolute path, no ~ —
# e.g. SSL_CERT_FILE=/Users/<you>/Library/Application Support/mkcert/rootCA.pem
SSL_CERT_FILE=

# CCGW Proxy endpoint the gateway routes the fable tier to. Must be an origin with
# no path; the opus tier needs the /v1 form below instead. Must be switched at the
# same time as CCGW_PROXY_TLS, CCGW_PROXY_HOST, LITELLM_CCGW_PROXY_OPENAI_URL and
# SSL_CERT_FILE — changing only some of the five leaves the gateway unable to connect.
# Format: https://<host>:<port> — e.g. LITELLM_CCGW_PROXY_URL=https://<mac-lan-ip>:8443
LITELLM_CCGW_PROXY_URL=https://<mac-lan-ip>:8443

# The same CCGW Proxy endpoint with a /v1 suffix, used by the opus tier. Point both
# at one host and port; only the suffix differs, and omitting it makes opus requests
# fail with "404 page not found" while the fable tier keeps working.
# Format: https://<host>:<port>/v1 — e.g. LITELLM_CCGW_PROXY_OPENAI_URL=https://<mac-lan-ip>:8443/v1
LITELLM_CCGW_PROXY_OPENAI_URL=https://<mac-lan-ip>:8443/v1

# Credential the gateway presents to the CCGW Proxy. Must match
# CCGW_PROXY_AUTH_TOKEN.
# Format: any non-empty string — e.g. LITELLM_CCGW_PROXY_API_KEY=<generated-secret>
LITELLM_CCGW_PROXY_API_KEY=

# Windows PC endpoint serving the haiku and sonnet tiers: its Caddy TLS front, not
# llama-swap's own port, which stays loopback-only behind it. Sole backend for those
# tiers — no fallback if that PC is offline; its certificate is verified against
# SSL_CERT_FILE. Carries a /v1 suffix, and is the only endpoint addressing a host directly.
# Format: URL — e.g. LITELLM_LLAMASWAP_URL=https://<windows-lan-ip>:8443/v1
LITELLM_LLAMASWAP_URL=https://<windows-lan-ip>:8443/v1
